# Foreman configuration. Copy to .env. The only required change is MODEL_API_KEY.
# Every other value below is a working default.

# ---- Meta Model API (https://dev.meta.ai), OpenAI-compatible ----
MODEL_API_KEY=                                  # REQUIRED. Your Meta Model API key.
MODEL_API_BASE_URL=https://api.meta.ai/v1

# Reviewer reasons over metrics, logs and history. The Fixer proposes one fix per finding.
REVIEWER_MODEL=muse-wonder-1.0
FIXER_MODEL=muse-spark-1.3
REVIEWER_REASONING_EFFORT=medium
FIXER_REASONING_EFFORT=low
FOREMAN_MODEL_TIMEOUT=120                       # seconds per model call

# No API key? Set 1 to run on local stand-in models. Same pipeline, canned output.
FOREMAN_MOCK=0

# ---- Storage ----
# docker compose overrides MONGO_URI to mongodb://db:27017. Outside Docker, use localhost
# to read the same database, or leave empty for JSON files in data/db/.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=health_monitor

# Where the Reviewer reads Chip and Chuck from: auto (Mongo first, then data/inbox files), mongo, file
FOREMAN_INPUT=auto

# ---- Reviewing ----
FOREMAN_HISTORY_DAYS=7                          # how far back the Reviewer reads
FOREMAN_REVIEW_INTERVAL_MIN=0                   # built-in scheduler, minutes. 0 = manual only. Compose sets 30. Use 1 for a compressed demo.
FOREMAN_SERVER_NAME=demo-server                 # label on reports, dashboard and Telegram. Hostname if empty.

# ---- Applying fixes ----
FOREMAN_EXECUTOR=shell                          # shell (run on this host) or muse (hand to `muse exec`)
FOREMAN_EXECUTE_TIMEOUT=120

# ---- API / dashboard ----
FOREMAN_API_HOST=0.0.0.0
FOREMAN_API_PORT=8000

# ---- Telegram (optional): reports to your phone with Apply / Rerun buttons ----
# 1) Message @BotFather, /newbot, paste the token here.  2) Start Foreman, open the bot, send /start.
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY=issues                          # issues (default) or all